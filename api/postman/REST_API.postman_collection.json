      "item": [
        {
          "name": "New object",
          "id": "5eb0c921-5b19-4db7-8e66-8f31f23ce411",
          "uid": "28539474-5eb0c921-5b19-4db7-8e66-8f31f23ce411",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test: Verify Status Code is 200",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test: Verify Response Time",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "// Test: Verify Content-Type header",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "// Test: Verify Response is JSON object",
                  "pm.test(\"Response is a JSON object\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});",
                  "",
                  "// Test: Verify Created Object has ID",
                  "pm.test(\"Created object has ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.not.be.empty;",
                  "});",
                  "",
                  "// Test: Verify Created Object has createdAt",
                  "pm.test(\"Created object has createdAt timestamp\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('createdAt');",
                  "});",
                  "",
                  "// Test: Verify Name matches request",
                  "pm.test(\"Object name matches request\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.equal('Apple MacBook Pro 16');",
                  "});",
                  "",
                  "// Test: Verify Data object exists",
                  "pm.test(\"Object has data property\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "});",
                  "",
                  "// Test: Verify Data fields match request",
                  "pm.test(\"Data fields match request\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.year).to.equal(2019);",
                  "    pm.expect(jsonData.data.price).to.equal(1849.99);",
                  "    pm.expect(jsonData.data['CPU model']).to.equal('Intel Core i9');",
                  "    pm.expect(jsonData.data['Hard disk size']).to.equal('1 TB');",
                  "});",
                  "",
                  "// Test: Verify Data Types",
                  "pm.test(\"Object properties have correct types\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "    pm.expect(jsonData.name).to.be.a('string');",
                  "    pm.expect(jsonData.data.year).to.be.a('number');",
                  "    pm.expect(jsonData.data.price).to.be.a('number');",
                  "});",
                  "",
                  "// Save created object ID for cleanup",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"created_object_id\", jsonData.id);",
                  "    console.log(\"Created object with ID: \" + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
