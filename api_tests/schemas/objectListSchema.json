{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Object List Schema",
  "description": "Schema for list of objects returned by restful-api.dev",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "data"],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the object"
      },
      "name": {
        "type": "string",
        "description": "Name of the object"
      },
      "data": {
        "oneOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "minItems": 0
}
